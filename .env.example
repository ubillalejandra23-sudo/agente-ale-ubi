# ── Obligatorias ──────────────────────────────────────────────
# Clave del proveedor del modelo (valor ficticio; use la suya en .env o en las variables de la nube; NO se sube al repositorio)
ANTHROPIC_API_KEY=sk-ant-REEMPLAZAR
# Claves que los clientes deben enviar en X-API-Key (separadas por coma). Genere una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# (Esta clave de ejemplo es pública: si la deja sin cambiar, el servidor la rechaza y responde 503.)
API_KEYS=clave-ficticia-cambiar-por-una-larga-y-aleatoria
# Dirección pública del agente en la nube (la ficha publica aquí dónde encontrarlo).
# Local: http://127.0.0.1:8000 | Heroku: https://<tu-app>.herokuapp.com
URL_PUBLICA=http://127.0.0.1:8000

# ── Opcionales ────────────────────────────────────────────────
# Modelo del agente (usa herramientas y entrega cifras): Sonnet por defecto
MODELO=claude-sonnet-5-5
# Modo económico: Haiku + topes menores. Solo para desarrollo (puede omitir datos). 1 = activar
ECONOMICO=0
# Topes de longitud de respuesta (si se corta, se avisa) y mensajes de historial que se envían al modelo
MAX_TOKENS=2500
HISTORIAL_MAX_MENSAJES=24
# Caché de prompts de Anthropic (0 = desactivar)
PROMPT_CACHE=1
# Consultas por minuto y por clave en /chat (0 = sin límite)
RATE_LIMIT_PER_MIN=20
